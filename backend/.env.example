TRICKEE_DATABASE_URL=postgresql+psycopg2://trickee:change-me@db:5432/trickee
TRICKEE_SECRET_KEY=replace-with-at-least-32-random-characters
TRICKEE_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
TRICKEE_GOOGLE_WORKSPACE_DOMAIN=company.example
TRICKEE_ACCESS_TOKEN_EXPIRE_MINUTES=1440
TRICKEE_USER_REFRESH_TOKEN_EXPIRE_DAYS=30
TRICKEE_DEVICE_ACCESS_TOKEN_EXPIRE_MINUTES=60
TRICKEE_DEVICE_REFRESH_TOKEN_EXPIRE_DAYS=90
TRICKEE_ALLOWED_ORIGINS=https://your-admin.example.com
TRICKEE_GPS_RAW_RETENTION_DAYS=90
TRICKEE_MAX_BATCH_POINTS=500
TRICKEE_DEBUG=false
TRICKEE_REDIS_URL=redis://redis:6379/0
# Required only for rediss:// production connections.
TRICKEE_REDIS_CA_CERT=/var/run/secrets/redis/ca.pem
TRICKEE_DB_POOL_SIZE=2
TRICKEE_DB_MAX_OVERFLOW=1
TRICKEE_DB_POOL_TIMEOUT_SECONDS=10
